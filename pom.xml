<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- Versión del modelo POM que usa Maven -->
    <modelVersion>4.0.0</modelVersion>

    <!-- Identificadores básicos del proyecto -->
    <groupId>org.example</groupId>       <!-- Grupo o dominio inverso -->
    <artifactId>test1</artifactId>       <!-- Nombre del artefacto/proyecto -->
    <version>1.0-SNAPSHOT</version>      <!-- Versión del proyecto -->

    <!-- Propiedades globales de compilación -->
    <properties>
        <maven.compiler.source>21</maven.compiler.source> <!-- Versión de Java usada como fuente -->
        <maven.compiler.target>21</maven.compiler.target> <!-- Versión de Java para generar bytecode -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding> <!-- Codificación de archivos -->
    </properties>

    <!-- Dependencias externas necesarias -->
    <dependencies>
        <!-- Selenium: librería principal para automatización de navegadores -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>4.38.0</version>
        </dependency>

        <!-- JUnit 6 (Jupiter): framework de testing moderno
        a diferencia del 5 solo con este trae las 2 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.0.1</version>
            <scope>test</scope>
        </dependency>

        <!-- WebDriverManager: gestiona automáticamente los drivers (Chrome, Firefox, etc.) -->
        <dependency>
            <groupId>io.github.bonigarcia</groupId>
            <artifactId>webdrivermanager</artifactId>
            <version>6.3.2</version>
        </dependency>

        <!-- https://mvnrepository.com/artifact/commons-io/commons-io
        para fileUtils-->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.21.0</version>
        </dependency>
    </dependencies>

    <!-- Configuración de compilación y plugins -->
    <build>
        <plugins>
            <!-- Maven Compiler Plugin: define cómo compilar el código Java -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source> <!-- Versión mínima de Java aceptada -->
                    <target>17</target> <!-- Versión de bytecode generado -->
                </configuration>
            </plugin>

            <!-- Maven Surefire Plugin: ejecuta las pruebas unitarias con JUnit -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
            </plugin>
        </plugins>
    </build>

</project>